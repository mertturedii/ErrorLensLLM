@inherits LayoutComponentBase
@inject DashboardFormat Format

<div class="shell">
    <aside class="side">
        <a class="brand" href="" aria-label="ErrorLensLLM">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                <circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 21 21" /><path d="M7.5 11.5 9.5 9l2 3 2-2.5" stroke-width="1.8" stroke-linejoin="round" />
            </svg>
            <span>ErrorLensLLM</span>
        </a>

        <nav class="nav" aria-label="Ekranlar">
            <NavLink href="" Match="NavLinkMatch.All">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="2" y="2" width="5" height="5" rx="1" /><rect x="9" y="2" width="5" height="5" rx="1" /><rect x="2" y="9" width="5" height="5" rx="1" /><rect x="9" y="9" width="5" height="5" rx="1" /></svg>
                Genel Bakış
            </NavLink>
            <NavLink href="olaylar">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2 14.5 13.5h-13z" /><path d="M8 6.5v3.2M8 11.6v.1" /></svg>
                Olaylar
            </NavLink>
            <NavLink href="hatalar">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2 14 5 8 8 2 5z" /><path d="m2 8 6 3 6-3M2 11l6 3 6-3" /></svg>
                Hata Grupları
            </NavLink>
            <NavLink href="deploylar">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 10.5V2M4.5 5.5 8 2l3.5 3.5M2.5 10v3.5h11V10" /></svg>
                Deploylar
            </NavLink>
            <NavLink href="izleme">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1.5 8.5h3l2-5 3 9 2-4h3" /></svg>
                Log İzleme
            </NavLink>
            <NavLink href="anomaliler">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 13.5h12" /><path d="M3.5 11V8M6.5 11V5M9.5 11V2.5M12.5 11V7" /></svg>
                Anomali Tespiti
            </NavLink>
            <NavLink href="degerlendirme">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="8" r="6" /><path d="m5.5 8.2 1.8 1.8 3.4-3.8" /></svg>
                Değerlendirme
            </NavLink>
            <NavLink href="yapay-zeka">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 1.8v2M8 12.2v2M1.8 8h2M12.2 8h2" /><rect x="4" y="4" width="8" height="8" rx="2" /><path d="M6.5 9.5 8 6.5l1.5 3M7 8.7h2" /></svg>
                Yapay Zekâ İstekleri
            </NavLink>
            <NavLink href="ayarlar">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="8" r="2.2" /><path d="M8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.4 3.4l1.4 1.4M11.2 11.2l1.4 1.4M3.4 12.6l1.4-1.4M11.2 4.8l1.4-1.4" /></svg>
                Sistem Ayarları
            </NavLink>
        </nav>

        <div class="side-foot">
            <div class="live" title="Açık ekran kendiliğinden yenilenir"><span class="pulse"></span>Canlı · @Format.Refresh.TotalSeconds sn</div>
            <button type="button" class="theme-toggle" onclick="errorLensTheme.toggle()" aria-label="Açık / koyu tema">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="8" cy="8" r="5.5" /><path d="M8 2.5a5.5 5.5 0 0 0 0 11z" fill="currentColor" /></svg>
                <span>Tema</span>
            </button>
        </div>
    </aside>

    <main class="main">
        <div class="inner">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui">
    Beklenmeyen bir hata oluştu.
    <a href="" class="reload">Yenile</a>
    <a class="dismiss">🗙</a>
</div>
