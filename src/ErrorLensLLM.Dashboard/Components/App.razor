<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* Before the stylesheet, so a remembered theme never flashes the other one *@
    <script>
        try {
            const theme = localStorage.getItem("errorlens-theme");
            if (theme) document.documentElement.dataset.theme = theme;
        } catch { }
    </script>
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="stylesheet" href="app.css?v=@Version" />
    <HeadOutlet @rendermode="Interactive" />
</head>

<body>
    <Routes @rendermode="Interactive" />
    <script src="app.js?v=@Version"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    // No prerender: a prerendered page would query everything twice and flash "loading" when the circuit takes over
    // Changes with every build, so that a browser never keeps an old app.css or app.js after an update
    private static readonly string Version = System.IO.File.GetLastWriteTimeUtc(typeof(App).Assembly.Location).Ticks.ToString("x");

    private static readonly IComponentRenderMode Interactive = new InteractiveServerRenderMode(prerender: false);
}
