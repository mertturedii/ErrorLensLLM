@page "/"
@implements IDisposable
@inject PostgresDashboardStore Store
@inject DashboardFormat Format
@inject NavigationManager Navigation

<PageTitle>Olaylar · ErrorLensLLM</PageTitle>

<div class="page-head">
    <h1>Olaylar</h1>
    <div class="tabs" role="tablist">
        @foreach (var (value, label) in Filters)
        {
            <button role="tab" class="@(_status == value ? "active" : "")" aria-selected="@(_status == value)"
                    @onclick="() => SelectAsync(value)">@label</button>
        }
    </div>
</div>

<div class="card">
    @if (_incidents is null)
    {
        <div class="empty">Yükleniyor…</div>
    }
    else if (_incidents.Count == 0)
    {
        <div class="empty">
            @(_status == "open" ? "Şu an açık olay yok." : "Kayıtlı olay yok.")
            <div class="muted">Demo için: <code>scripts/demo.sh start</code>, ardından <code>scripts/demo.sh deploy kayit 1.1.0 kayit-missing-column</code></div>
        </div>
    }
    else
    {
        <table class="list">
            <thead>
                <tr>
                    <th>Durum</th>
                    <th>Başladı</th>
                    <th>Olay</th>
                    <th class="hide-narrow">Kategori</th>
                    <th class="hide-narrow">Modüller</th>
                    <th class="num">Hata</th>
                    <th class="hide-narrow">Geri bildirim</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var incident in _incidents)
                {
                    <tr class="clickable" @onclick="() => Open(incident.Id)">
                        <td><span class="badge @incident.Status"><span class="dot"></span>@DashboardFormat.Status(incident.Status)</span></td>
                        <td class="num">
                            @Format.Time(incident.StartedAt)
                            <div class="muted">@DashboardFormat.Duration(incident.LastSeen - incident.StartedAt)</div>
                        </td>
                        <td><a href="olaylar/@incident.Id" @onclick:stopPropagation>@incident.Title</a></td>
                        <td class="hide-narrow">@DashboardFormat.Category(incident.Category)</td>
                        <td class="hide-narrow">@string.Join(", ", incident.Applications)</td>
                        <td class="num">@incident.Occurrences.ToString("N0")</td>
                        <td class="hide-narrow"><Verdict Value="@incident.Verdict" /></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<p class="muted">Son güncelleme @(_updated is { } u ? Format.Time(u) : "—") · @Format.Refresh.TotalSeconds sn'de bir yenilenir</p>

@code {
    private static readonly (string? Value, string Label)[] Filters = [("open", "Açık"), ("closed", "Kapanan"), (null, "Tümü")];

    private readonly CancellationTokenSource _stop = new();
    private IReadOnlyList<IncidentSummary>? _incidents;
    private string? _status = "open";
    private DateTimeOffset? _updated;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _ = RefreshLoopAsync();
    }

    private async Task SelectAsync(string? status)
    {
        _status = status;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _incidents = await Store.ListIncidentsAsync(_status, ct: _stop.Token);
        _updated = DateTimeOffset.UtcNow;
    }

    private async Task RefreshLoopAsync()
    {
        using var timer = new PeriodicTimer(Format.Refresh);
        try
        {
            while (await timer.WaitForNextTickAsync(_stop.Token))
            {
                await LoadAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Page closed
        }
    }

    private void Open(Guid id) => Navigation.NavigateTo($"olaylar/{id}");

    public void Dispose()
    {
        _stop.Cancel();
        _stop.Dispose();
    }
}
