@page "/olaylar"
@inherits RefreshingPage
@inject PostgresDashboardStore Store

<PageTitle>Olaylar · ErrorLensLLM</PageTitle>

<div class="page-head">
    <div>
        <h1>Olaylar</h1>
        <div class="sub">Aynı kök nedene bağlanan hata grupları tek olayda toplanır</div>
    </div>
    <div class="tabs" role="tablist" aria-label="Durum">
        @foreach (var (value, label) in Statuses)
        {
            <button role="tab" class="@(_status == value ? "active" : "")" aria-selected="@(_status == value)"
                    @onclick="() => SelectAsync(value)">@label</button>
        }
    </div>
</div>

<div class="filters">
    <input type="search" placeholder="Başlıkta ara" aria-label="Başlıkta ara" @bind="_search" @bind:event="oninput" />
    <select aria-label="Kategori" @bind="_category">
        <option value="">Tüm kategoriler</option>
        @foreach (var category in _incidents.Select(i => i.Category).Distinct().OrderBy(c => DashboardFormat.Category(c)))
        {
            <option value="@category">@DashboardFormat.Category(category)</option>
        }
    </select>
    <select aria-label="Modül" @bind="_module">
        <option value="">Tüm modüller</option>
        @foreach (var module in Colors.Sort(_incidents.SelectMany(i => i.Applications)))
        {
            <option value="@module">@module</option>
        }
    </select>
    @if (_loaded)
    {
        <span class="count">@Visible.Count olay</span>
    }
</div>

<div class="card flush">
    @if (!_loaded)
    {
        <div class="empty">Yükleniyor…</div>
    }
    else if (_incidents.Count == 0)
    {
        <div class="empty">
            @(_status == "open" ? "Şu an açık olay yok." : "Kayıtlı olay yok.")
            <div class="muted">Demo için: <code>scripts/demo.sh start</code>, ardından <code>scripts/demo.sh deploy kayit 1.1.0 kayit-missing-column</code></div>
        </div>
    }
    else if (Visible.Count == 0)
    {
        <div class="empty">Bu filtrelere uyan olay yok.</div>
    }
    else
    {
        <IncidentTable Incidents="Visible" Sparks="_sparks" />
    }
</div>

<p class="foot-note">
    Son güncelleme @(Updated is { } u ? Format.Time(u) : "—")
    @if (RefreshError is not null)
    {
        <span class="warn"> · yenileme başarısız, eski veri gösteriliyor</span>
    }
</p>

@code {
    private static readonly (string? Value, string Label)[] Statuses = [("open", "Açık"), ("closed", "Kapanan"), (null, "Tümü")];

    private IReadOnlyList<IncidentSummary> _incidents = [];
    private IReadOnlyDictionary<Guid, int[]> _sparks = new Dictionary<Guid, int[]>();
    private bool _loaded;
    private string? _status = "open";
    private string _search = "";
    private string _category = "";
    private string _module = "";

    private IReadOnlyList<IncidentSummary> Visible => _incidents
        .Where(i => _search.Length == 0 || i.Title.Contains(_search.Trim(), StringComparison.CurrentCultureIgnoreCase))
        .Where(i => _category.Length == 0 || i.Category.ToString() == _category)
        .Where(i => _module.Length == 0 || i.Applications.Contains(_module))
        .ToList();

    protected override async Task LoadAsync()
    {
        _incidents = await Store.ListIncidentsAsync(_status, 200, Stopping);
        _sparks = await Store.IncidentSparksAsync(_incidents.Select(i => i.Id).ToList(), ct: Stopping);
        _loaded = true;
    }

    private async Task SelectAsync(string? status)
    {
        _status = status;
        await ReloadAsync();
    }
}
