@page "/olaylar/{Id:guid}"
@inherits RefreshingPage
@inject PostgresDashboardStore Store
@inject PostgresExplanationStore Explanations

<PageTitle>@(_incident?.Summary.Title ?? "Olay") · ErrorLensLLM</PageTitle>

<div class="crumb"><a href="olaylar">← Olaylar</a></div>

@if (_loaded && _incident is null)
{
    <div class="card empty">Olay bulunamadı.</div>
}
else if (_incident is { } incident)
{
    var summary = incident.Summary;
    var root = incident.Members[0];

    <div class="page-head">
        <div>
            <h1>@summary.Title</h1>
            <div class="meta">
                <span class="badge @summary.Status"><span class="dot"></span>@DashboardFormat.Status(summary.Status)</span>
                <span>@DashboardFormat.Category(summary.Category)</span>
                <span class="chips">
                    @foreach (var app in Applications)
                    {
                        <ModuleChip Name="@app" />
                    }
                </span>
            </div>
        </div>
    </div>

    <div class="stats">
        <Stat Label="Başladı" Value="@Format.Time(summary.StartedAt)" Hint="@Format.Local(summary.StartedAt).ToString("dd.MM.yyyy")" />
        <Stat Label="Süre" Value="@DashboardFormat.Duration(summary.LastSeen - summary.StartedAt)"
              Hint="@($"son hata {DashboardFormat.Relative(summary.LastSeen)}")" />
        <Stat Label="Hata" Value="@DashboardFormat.Number(summary.Occurrences)" Hint="@($"{incident.Members.Count} hata grubu")" />
        <Stat Label="Etkilenen servis" Value="@Applications.Count.ToString()" />
        <Stat Label="Kök neden skoru" Value="@root.RootCauseScore.ToString("0.00")" Hint="@RunnerUp(incident)" />
    </div>

    <div class="split">
        <div>
            <section class="card">
                <h2>Önerilen kök neden</h2>
                <div class="root-title">
                    <ModuleChip Name="@root.Application" />
                    <a class="title" href="hatalar/@root.Fingerprint"><strong>@DashboardFormat.ShortType(root.ExceptionType)</strong></a>
                </div>
                <div class="mono secondary">@root.NormalizedMessage</div>
                @if (root.TopFrame is not null)
                {
                    <div class="muted small">Kod konumu: <code>@root.TopFrame</code></div>
                }
                <ul class="evidence">
                    @foreach (var line in root.Evidence)
                    {
                        <li>@line</li>
                    }
                </ul>
            </section>

            <section class="card">
                <div class="card-head">
                    <h2>Yapay zekâ açıklaması</h2>
                    @if (_explanation is { Json: not null } done)
                    {
                        <span class="muted small">@done.Model · @Format.Stamp(done.CreatedAt) · @DashboardFormat.Number(done.InputTokens + done.OutputTokens) token</span>
                    }
                </div>
                @if (_explanation is null)
                {
                    <div class="callout secondary small">
                        Bu olay için açıklama yok. LLM katmanı collector'da <code>GEMINI_API_KEY</code> ya da <code>ANTHROPIC_API_KEY</code> tanımlıyken açılır
                        ve her yeni olayı, ilk dalgası oturduktan (30 sn) sonra bir kez açıklar; kök neden değişirse yeniden açıklar.
                        Katman açılmadan bir saatten daha önce başlayan olaylar geriye dönük açıklanmaz.
                    </div>
                }
                else if (_explanation.Json is null)
                {
                    <div class="callout secondary small">Açıklama üretilemedi: @_explanation.Error (10 dk sonra yeniden denenecek)</div>
                }
                else if (_explained is { } x)
                {
                    @if (_explanation.RootFingerprint != _incident!.RootFingerprint)
                    {
                        <div class="callout secondary small">Bu açıklama önceki kök neden adayı için yazıldı; yenisi hazırlanıyor.</div>
                    }
                    <p>@x.Summary</p>
                    <dl class="explain">
                        <dt>Kök neden</dt>
                        <dd>@x.RootCause</dd>
                        <dt>Etki</dt>
                        <dd>@x.Impact</dd>
                        <dt>Sonraki adımlar</dt>
                        <dd>
                            <ol>
                                @foreach (var step in x.NextSteps)
                                {
                                    <li>@step</li>
                                }
                            </ol>
                        </dd>
                        <dt>Güven</dt>
                        <dd>@x.Confidence</dd>
                        @if (!string.IsNullOrWhiteSpace(x.Disagreement))
                        {
                            <dt>Sıralamaya itiraz</dt>
                            <dd class="warn">@x.Disagreement</dd>
                        }
                    </dl>
                    <div class="muted small">
                        Model, sistemin sıraladığı adayları ve kanıtları açıklar; öneri kararı kural tabanlı sıralamadır. Modele giden tüm metinler
                        collector'da maskelendi.
                    </div>
                }
            </section>

            <section class="card">
                <h2>Zaman çizelgesi</h2>
                <StackedBars Points="_timeline" Bucket="_bucket" Deployments="_deployments" Series="Applications" Color="Colors.Of"
                             Highlighted="incident.SuspectedDeployment" Label="Servis bazında zaman içindeki hata sayısı"
                             EmptyText="Bu olay için zaman çizelgesi verisi yok." />
            </section>

            <section class="card flush">
                <h2>Kök neden adayları</h2>
                <div class="scroll-x">
                    <table class="list">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Servis</th>
                                <th>Hata</th>
                                <th class="hide-narrow">Kategori</th>
                                <th class="num">Sayı</th>
                                <th>Skor</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < incident.Members.Count; i++)
                            {
                                var member = incident.Members[i];
                                <tr @key="member.Fingerprint">
                                    <td class="num">@(i + 1)</td>
                                    <td><ModuleChip Name="@member.Application" /></td>
                                    <td>
                                        <a class="title" href="hatalar/@member.Fingerprint">@DashboardFormat.ShortType(member.ExceptionType)</a>
                                        <div class="mono secondary">@member.NormalizedMessage</div>
                                        @if (member.Evidence.Count > 0)
                                        {
                                            <div class="muted small">@string.Join(" · ", member.Evidence)</div>
                                        }
                                    </td>
                                    <td class="hide-narrow">@DashboardFormat.Category(member.Category)</td>
                                    <td class="num">@DashboardFormat.Number(member.Occurrences)</td>
                                    <td>
                                        <div class="meter">
                                            <div class="track"><span style="width:@Percent(member.RootCauseScore)"></span></div>
                                            <span class="num">@member.RootCauseScore.ToString("0.00")</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="card">
                <div class="card-head">
                    <h2>@(_tab == "trace" ? "Hatanın yayılışı" : "Son hatalar")</h2>
                    <div class="tabs" role="tablist" aria-label="Kayıtlar">
                        <button role="tab" class="@(_tab == "trace" ? "active" : "")" aria-selected="@(_tab == "trace")"
                                @onclick='() => _tab = "trace"'>İstek zinciri</button>
                        <button role="tab" class="@(_tab == "recent" ? "active" : "")" aria-selected="@(_tab == "recent")"
                                @onclick='() => _tab = "recent"'>Son hatalar</button>
                    </div>
                </div>

                @if (_tab == "trace")
                {
                    @if (_trace.Count == 0)
                    {
                        <div class="empty">Kök nedenle başka bir üyenin birlikte hata verdiği bir istek zinciri yok.</div>
                    }
                    else
                    {
                        <p class="muted small">Örnek bir isteğin servisler arasındaki izi · trace <a href="izler/@_trace[0].TraceId"><code>@_trace[0].TraceId</code></a> · <a href="izler/@_trace[0].TraceId">isteğin tüm yolunu aç →</a></p>
                        <ol class="trace">
                            @foreach (var e in _trace)
                            {
                                <li class="@(e.Fingerprint == root.Fingerprint ? "is-root" : "")">
                                    <span class="num muted">@Format.TimeWithMs(e.Timestamp)</span>
                                    <ModuleChip Name="@e.Application" />
                                    <span class="level">@DashboardFormat.Level(e.Level)</span>
                                    <span>@(e.ExceptionType is null ? e.Message : DashboardFormat.ShortType(e.ExceptionType))</span>
                                    @if (e.Fingerprint == root.Fingerprint)
                                    {
                                        <span class="badge open"><span class="dot"></span>kök neden</span>
                                    }
                                </li>
                            }
                        </ol>
                    }
                }
                else
                {
                    <div class="scroll-x">
                        <table class="list">
                            <thead>
                                <tr>
                                    <th>Zaman</th>
                                    <th>Servis</th>
                                    <th>Hata</th>
                                    <th class="hide-narrow">Trace</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var e in _recent)
                                {
                                    <tr class="expandable @(_open.Contains(e.Id) ? "open" : "")" @onclick="() => Toggle(e.Id)" title="Ayrıntılar için tıkla">
                                        <td class="num left">@Format.TimeWithMs(e.Timestamp)</td>
                                        <td><ModuleChip Name="@e.Application" /></td>
                                        <td>
                                            <strong>@DashboardFormat.ShortType(e.ExceptionType)</strong>
                                            <div class="secondary small">@(e.ExceptionMessage ?? e.Message)</div>
                                        </td>
                                        <td class="hide-narrow">@if (e.TraceId is not null) { <a href="izler/@e.TraceId" @onclick:stopPropagation="true"><code>@e.TraceId[..Math.Min(8, e.TraceId.Length)]</code></a> }</td>
                                    </tr>
                                    @if (_open.Contains(e.Id))
                                    {
                                        <LogDetailRow Id="e.Id" Columns="4" />
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>

        <aside>
            <section class="card">
                <h2>Şüpheli deploy</h2>
                @if (incident.SuspectedDeployment is { } deployment)
                {
                    var gap = summary.StartedAt - deployment.StartedAt;
                    <div class="root-title">
                        <ModuleChip Name="@deployment.Application" />
                        <strong>@deployment.Version</strong>
                    </div>
                    <div class="secondary">
                        @(gap.Duration() < TimeSpan.FromSeconds(1) ? "Olayla aynı anda"
                            : $"Olaydan {DashboardFormat.Duration(gap.Duration())} {(gap > TimeSpan.Zero ? "önce" : "sonra")}")
                    </div>
                    <div class="muted small">@Format.DateTime(deployment.StartedAt)</div>
                    @if (!string.IsNullOrEmpty(deployment.CommitSha))
                    {
                        <div class="muted small">Commit <code>@DashboardFormat.ShortCommit(deployment.CommitSha)</code></div>
                    }
                    <p class="small" style="margin:10px 0 0"><a href="deploylar">Deploy geçmişi →</a></p>
                }
                else
                {
                    <div class="secondary">Olaydan hemen önce sürüm değiştiren bir deploy yok.</div>
                }
            </section>

            <section class="card">
                <h2>Geri bildirim</h2>
                @if (_feedback is { } given && !_editing)
                {
                    <div>
                        <Verdict Value="@given.Verdict" />
                        <span class="muted small">@Format.DateTime(given.CreatedAt)</span>
                    </div>
                    @if (given.CorrectFingerprint is { } correct && incident.Members.FirstOrDefault(m => m.Fingerprint == correct) is { } chosen)
                    {
                        <p class="secondary" style="margin-top:8px">Gerçek kök neden: <strong>@chosen.Application · @DashboardFormat.ShortType(chosen.ExceptionType)</strong></p>
                    }
                    @if (!string.IsNullOrEmpty(given.Comment))
                    {
                        <p class="secondary" style="margin-top:8px">“@given.Comment”</p>
                    }
                    <button class="secondary" style="margin-top:10px" @onclick="() => _editing = true">Değiştir</button>
                }
                else
                {
                    <p class="secondary">Önerilen kök neden (<strong>@root.Application · @DashboardFormat.ShortType(root.ExceptionType)</strong>) doğru mu?</p>
                    <div class="actions">
                        <button class="@(_verdict == "correct" ? "primary" : "secondary")" aria-pressed="@(_verdict == "correct")"
                                @onclick='() => _verdict = "correct"'>Doğru</button>
                        <button class="@(_verdict == "wrong" ? "primary" : "secondary")" aria-pressed="@(_verdict == "wrong")"
                                @onclick='() => _verdict = "wrong"'>Yanlış</button>
                    </div>
                    @if (_verdict == "wrong")
                    {
                        <label class="field">
                            <span class="secondary small">Gerçek kök neden hangisi? (isteğe bağlı)</span>
                            <select @bind="_correctFingerprint">
                                <option value="">Bilmiyorum / listede yok</option>
                                @foreach (var member in incident.Members.Skip(1))
                                {
                                    <option value="@member.Fingerprint">@member.Application · @DashboardFormat.ShortType(member.ExceptionType)</option>
                                }
                            </select>
                        </label>
                    }
                    @if (_verdict is not null)
                    {
                        <label class="field">
                            <span class="secondary small">Not (isteğe bağlı)</span>
                            <textarea rows="3" @bind="_comment"></textarea>
                        </label>
                        <button class="primary" disabled="@_saving" @onclick="SaveFeedbackAsync">Kaydet</button>
                    }
                    else
                    {
                        <p class="muted small" style="margin:0">Kararlar <a href="degerlendirme">Değerlendirme</a> ekranındaki doğruluk ölçümünü besler.</p>
                    }
                }
            </section>
        </aside>
    </div>
}
else
{
    <div class="card empty">Yükleniyor…</div>
}

@code {
    private readonly HashSet<long> _open = [];

    private void Toggle(long id)
    {
        if (!_open.Remove(id))
            _open.Add(id);
    }

    [Parameter] public Guid Id { get; set; }

    private IncidentDetail? _incident;
    private bool _loaded;
    private IReadOnlyList<TimelinePoint> _timeline = [];
    private TimeSpan _bucket;
    private IReadOnlyList<DeploymentView> _deployments = [];
    private IReadOnlyList<LogEventView> _trace = [];
    private IReadOnlyList<LogEventView> _recent = [];
    private FeedbackView? _feedback;
    private ExplanationRow? _explanation;
    private Explained? _explained;

    private sealed record Explained(string Summary, string RootCause, string Impact, List<string> NextSteps, string Confidence, string? Disagreement);

    private string _tab = "trace";
    private string? _verdict;
    private string _correctFingerprint = "";
    private string? _comment;
    private bool _saving;
    private bool _editing;

    private IReadOnlyList<string> Applications => Colors.Sort(_incident?.Summary.Applications ?? []);

    protected override async Task LoadAsync()
    {
        _incident = await Store.GetIncidentAsync(Id, Stopping);
        _loaded = true;
        if (_incident is null)
            return;

        (_bucket, _timeline) = await Store.TimelineAsync(_incident.Summary, Stopping);
        _deployments = await Store.DeploymentsAroundAsync(_incident.Summary, Stopping);
        _trace = await Store.SampleTraceAsync(Id, _incident.RootFingerprint, Stopping);
        _recent = await Store.RecentErrorsAsync(Id, ct: Stopping);
        _feedback = await Store.LatestFeedbackAsync(Id, Stopping);
        _explanation = await Explanations.LatestAsync(Id, Stopping);
        _explained = _explanation?.Json is { } json
            ? System.Text.Json.JsonSerializer.Deserialize<Explained>(json, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web))
            : null;
    }

    private async Task SaveFeedbackAsync()
    {
        if (_verdict is null)
            return;

        _saving = true;
        await Store.SaveFeedbackAsync(Id, _verdict, _verdict == "wrong" && _correctFingerprint != "" ? _correctFingerprint : null, _comment);
        _feedback = await Store.LatestFeedbackAsync(Id);
        (_verdict, _correctFingerprint, _comment, _saving, _editing) = (null, "", null, false, false);
    }

    /// <summary>How far ahead the suggestion is: a narrow lead means the ranking deserves a second look.</summary>
    private static string RunnerUp(IncidentDetail incident) => incident.Members.Count > 1
        ? $"2. aday {incident.Members[1].RootCauseScore:0.00}"
        : "tek aday";

    private static string Percent(double score) => $"{Math.Clamp(score, 0, 1) * 100:0}%";
}
