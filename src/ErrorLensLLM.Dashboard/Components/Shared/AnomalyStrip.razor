@* One module's live DeepLog share over time: a bar per display bucket, the threshold as a dashed line, flagged buckets
   in the critical color. Every bar carries its own tooltip; the table beside it holds the numbers. *@
<svg class="anomaly-strip" viewBox="0 0 @(Width) @(Height)" preserveAspectRatio="none" role="img" aria-label="@Label"
     style="color:@Color">
    <line x1="0" x2="@Width" y1="@F(Height - 0.5)" y2="@F(Height - 0.5)" class="base" />
    @for (var i = 0; i < Slots.Count; i++)
    {
        var slot = Slots[i];
        if (slot is null)
            continue;
        var height = Math.Max(Plot * Math.Min(slot.MaxShare, 1), slot.Anomalous > 0 ? 3 : 1);
        <rect x="@F(i * Step + 0.5)" y="@F(Height - 1 - height)" width="@F(Step - 1)" height="@F(height)"
              class="@(slot.Anomalous > 0 ? "flag" : null)">
            <title>@Tooltip(slot)</title>
        </rect>
    }
    @if (Threshold is { } threshold)
    {
        <line x1="0" x2="@Width" y1="@F(Height - 1 - Plot * Math.Min(threshold, 1))" y2="@F(Height - 1 - Plot * Math.Min(threshold, 1))"
              class="threshold" />
    }
</svg>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AnomalyPoint?> Slots { get; set; } = [];
    [Parameter] public double? Threshold { get; set; }
    [Parameter] public string Color { get; set; } = "var(--series-1)";
    [Parameter] public string Label { get; set; } = "DeepLog anomali oranı";
    [Parameter] public Func<AnomalyPoint, string> Tooltip { get; set; } = p => p.Bucket.ToString("HH:mm");

    private const double Step = 4, Height = 36, Plot = 32;
    private double Width => Math.Max(Slots.Count, 1) * Step;

    private static string F(double value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}
