@* Errors per time bucket, stacked by application, with deployment markers. Inline SVG, no script. *@
@inject DashboardFormat Format

@if (Points.Count == 0)
{
    <div class="empty">Bu olay için zaman çizelgesi verisi yok.</div>
}
else
{
    <div class="legend">
        @for (var i = 0; i < Applications.Count; i++)
        {
            <span class="chip"><span class="swatch" style="background:@Color(i)"></span>@Applications[i]</span>
        }
        <span class="chip"><span class="deploy-swatch"></span>deploy</span>
    </div>

    <svg viewBox="0 0 @Width @Height" class="timeline" role="img"
         aria-label="Modül bazında zaman içindeki hata sayısı; ayrıntılar aşağıdaki tabloda">
        @* Recessive grid and axis *@
        @foreach (var tick in YTicks)
        {
            var y = Y(tick);
            <g>
                <line x1="@Left" x2="@(Width - Right)" y1="@y" y2="@y" class="grid" />
                <text x="@(Left - 6)" y="@(y + 4)" class="tick" text-anchor="end">@tick</text>
            </g>
        }

        @for (var b = 0; b < _buckets.Count; b++)
        {
            var x = Left + b * Slot;
            var stacked = 0;
            for (var a = 0; a < Applications.Count; a++)
            {
                var count = Count(_buckets[b], Applications[a]);
                if (count == 0)
                    continue;

                var top = Y(stacked + count);
                var height = Y(stacked) - top;
                stacked += count;
                <rect x="@F(x + 1)" y="@F(top)" width="@F(Math.Max(Slot - 2, 1))" height="@F(height)"
                      fill="@Color(a)" class="segment">
                    <title>@Applications[a] · @Format.Time(_buckets[b]) · @count hata</title>
                </rect>
            }
        }

        <line x1="@Left" x2="@(Width - Right)" y1="@Y(0)" y2="@Y(0)" class="axis" />

        @foreach (var tick in XTicks)
        {
            <g><text x="@F(Left + tick * Slot + Slot / 2)" y="@(Height - 8)" class="tick" text-anchor="middle">@Format.Time(_buckets[tick])</text></g>
        }

        @foreach (var deployment in Deployments.Where(d => d.StartedAt >= _buckets[0] && d.StartedAt <= _end))
        {
            var x = Left + (deployment.StartedAt - _buckets[0]) / Bucket * Slot;
            var suspected = deployment == Highlighted;
            <g>
                <line x1="@F(x)" x2="@F(x)" y1="@Top" y2="@Y(0)" class="@(suspected ? "deploy suspected" : "deploy")">
                    <title>@deployment.Application @deployment.Version · @Format.Time(deployment.StartedAt)</title>
                </line>
                @* Only the suspected trigger is labelled; releases often land together and their labels would collide *@
                @if (suspected)
                {
                    <g><text x="@F(x + 4)" y="@(Top + 10)" class="deploy-label">@deployment.Application @deployment.Version</text></g>
                }
            </g>
        }
    </svg>

    <details>
        <summary>Tablo olarak göster</summary>
        <table class="list">
            <thead>
                <tr>
                    <th>Zaman</th>
                    @foreach (var app in Applications)
                    {
                        <th class="num">@app</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var bucket in _buckets.Where(b => Applications.Any(a => Count(b, a) > 0)))
                {
                    <tr>
                        <td class="num" style="text-align:left">@Format.Time(bucket)</td>
                        @foreach (var app in Applications)
                        {
                            <td class="num">@Count(bucket, app)</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </details>
}

@code {
    private const int Width = 800, Height = 220, Left = 44, Right = 12, Top = 14, Bottom = 30;

    [Parameter, EditorRequired] public IReadOnlyList<TimelinePoint> Points { get; set; } = [];
    [Parameter, EditorRequired] public TimeSpan Bucket { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<DeploymentView> Deployments { get; set; } = [];

    /// <summary>Fixed order, so an application keeps its color on every screen of the incident.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<string> Applications { get; set; } = [];

    /// <summary>The suspected deployment; drawn stronger and labelled.</summary>
    [Parameter] public DeploymentView? Highlighted { get; set; }

    private List<DateTimeOffset> _buckets = [];
    private Dictionary<(DateTimeOffset, string), int> _counts = [];
    private DateTimeOffset _end;
    private int _max;

    private double Slot => (double)(Width - Left - Right) / Math.Max(_buckets.Count, 1);

    protected override void OnParametersSet()
    {
        if (Points.Count == 0)
            return;

        _counts = Points.ToDictionary(p => (p.Bucket, p.Application), p => p.Errors);
        var first = Points.Min(p => p.Bucket);
        var last = Points.Max(p => p.Bucket);

        // Every bucket gets a slot, empty ones included, so gaps in the incident stay visible
        _buckets = [];
        for (var b = first; b <= last; b += Bucket)
            _buckets.Add(b);
        _end = last + Bucket;

        _max = _buckets.Max(b => Applications.Sum(a => Count(b, a)));
    }

    private int Count(DateTimeOffset bucket, string app) => _counts.GetValueOrDefault((bucket, app));

    private double Y(double value) => Top + (Height - Top - Bottom) * (1 - value / NiceMax);

    private int NiceMax
    {
        get
        {
            var magnitude = Math.Pow(10, Math.Floor(Math.Log10(Math.Max(_max, 1))));
            var step = new[] { 1, 2, 2.5, 5, 10 }.First(s => s * magnitude * 4 >= _max) * magnitude;
            return (int)Math.Max(step * 4, 1);
        }
    }

    private IEnumerable<int> YTicks => Enumerable.Range(0, 5).Select(i => NiceMax * i / 4).Distinct();

    private IEnumerable<int> XTicks
    {
        get
        {
            var every = Math.Max(1, (int)Math.Ceiling(_buckets.Count / 6.0));
            return Enumerable.Range(0, _buckets.Count).Where(i => i % every == 0);
        }
    }

    private static string Color(int index) => index < 5 ? $"var(--series-{index + 1})" : "var(--series-other)";

    private static string F(double value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}
